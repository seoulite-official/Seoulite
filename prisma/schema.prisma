// This is your Prisma schema,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}


datasource db {
  provider = "postgresql"
}


model Issue {
// Existing fields remain
  id                  String   @id @default(uuid())
  slug                String   @unique
  number              Int
  date                String
  title               String?
  description         String
  // Cover image metadata (storage reference + file info)
  coverImageKey       String?     // Reference to storage (e.g., S3 key, Cloudinary public_id)
  coverImageOriginalName String?
  coverImageSize      Int?
  coverImageMimeType  String?
  coverImageUploadedAt DateTime?
  // Publication PDF metadata (storage reference + file info)
  publicationKey      String?     // Reference to storage (PDF file)
  publicationOriginalName String?
  publicationSize     Int?
  publicationMimeType String?
  publicationUploadedAt DateTime?
  published           Boolean   @default(false)
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([slug])
  @@index([number])
  @@index([published])
}


model User {
  active      Boolean @default(true)
  // Existing fields remain
  // Existing fields remain
  // Existing fields remain
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String   // hashed password
  role      String   @default("EDITOR") // e.g., EDITOR, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Invitation {
  id          String   @id @default(uuid())
  email       String
  role        String
  tokenHash   String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
